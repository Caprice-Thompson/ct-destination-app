{
  "scripts": {
    "build": "esbuild src/api/*.ts --minify --bundle --target=es2020 --platform=node --sourcemap --outdir=dist --external:pg-native",
    "build:migration": "esbuild migration-handler.ts --minify --bundle --target=es2020 --platform=node --sourcemap --outfile=migration-lambda/index.js --external:pg-native && cp -r src/infrastructure/repositories/db/migrations migration-lambda/",
    "package:migration": "npm run build:migration && cd migration-lambda && zip -r ../migration-lambda.zip . && cd ..",
    "db:migrate": "bash runMigrations.sh",
    "lint": "biome check --write .",
    "lint:fix": "biome check --fix --unsafe",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/winston": "^2.4.4",
    "esbuild": "^0.24.0",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.955.0",
    "@sentry/node": "^9.41.0",
    "jiti": "^2.6.1",
    "pg": "^8.16.3",
    "winston": "^3.18.3",
    "zod": "^4.1.13"
  }
}
