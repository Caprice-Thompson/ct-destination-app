# Copy to .env.local and fill in values.
# .env.local is gitignored — never commit real credentials or API keys.

# Local Postgres (see docker-compose.yml for default local values)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/destination_db
DB_USER=
DB_NAME=destination_db

# Local DynamoDB only — use dummy values for DynamoDB Local, not real AWS keys
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_ENDPOINT_URL=http://localhost:8000
DYNAMODB_WEATHER_TABLE=weather_data

# Required only for `migrate:countries` (REST Countries API)
# Put the real token in .env.local — leave blank here.
# REST_COUNTRIES_API_URL=https://api.restcountries.com/countries/v5
# REST_COUNTRIES_AUTHORIZATION=
