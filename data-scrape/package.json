{
  "name": "migration",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "migrate": "npm run migrate:all",
    "migrate:all": "npm run migrate:city && npm run migrate:national-dishes && npm run migrate:unesco && npm run migrate:weather && npm run migrate:countries",
    "migrate:seed": "npm run migrate:city && npm run migrate:national-dishes && npm run migrate:unesco && npm run migrate:weather",
    "migrate:city": "tsx src/application/migration_city.ts",
    "migrate:national-dishes": "tsx src/application/migration.ts",
    "migrate:unesco": "tsx src/application/unesco_migration.ts",
    "migrate:countries": "tsx src/application/migration_countries.ts",
    "migrate:weather": "tsx src/application/weather_migration.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "postgres": "^3.4.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.19.2"
  }
}
