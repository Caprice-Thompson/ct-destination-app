{
  "name": "tourism",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "build": "esbuild src/api/*.ts --minify --bundle --target=es2020 --platform=node --sourcemap --outdir=dist",
    "build:migration": "esbuild migration-handler.ts --minify --bundle --target=es2020 --platform=node --sourcemap --outfile=migration-lambda/index.js --external:pg-native && cp -r src/infrastructure/repositories/db/migrations migration-lambda/",
    "package:migration": "npm run build:migration && cd migration-lambda && zip -r ../migration-lambda.zip . && cd ..",
    "lint": "eslint ./src --fix",
    "lint:check": "eslint ./src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jiti": "^2.6.1",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.957.0",
    "@jest/test-sequencer": "^29.7.0",
    "jest-mock-extended": "^4.0.1",
    "pg": "^8.16.3",
    "winston": "^3.17.0",
    "zod": "^4.2.1"
  }
}
