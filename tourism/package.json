{
  "name": "tourism",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "build": "esbuild src/api/*.ts --minify --bundle --target=es2020 --platform=node --sourcemap --outdir=dist",
    "build:migration": "esbuild migration-handler.ts --minify --bundle --target=es2020 --platform=node --sourcemap --outfile=migration-lambda/index.js --external:pg-native && cp -r src/infrastructure/repositories/db/migrations migration-lambda/",
    "package:migration": "npm run build:migration && cd migration-lambda && zip -r ../migration-lambda.zip . && cd ..",
    "lint": "biome check --write .",
    "type-check": "tsc --noEmit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "esbuild": "^0.27.2",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jiti": "^2.6.1",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1045.0",
    "@aws-sdk/client-ssm": "^3.957.0",
    "@aws-sdk/lib-dynamodb": "^3.1045.0",
    "@jest/test-sequencer": "^29.7.0",
    "jest-mock-extended": "^4.0.1",
    "pg": "^8.16.3",
    "winston": "^3.17.0",
    "zod": "^4.2.1"
  }
}
